  \node[align=center,text=coverink,text width=175mm,inner sep=0pt]
    at ($(current page.south west)+(105mm,260mm)$)
    {{\RPGCoverTitleFont\fontsize{23}{27}\selectfont\spaceskip=.72em\relax #1}};
  \draw[coverink,line width=.45pt] ($(current page.south west)+(57mm,246mm)$)--($(current page.south west)+(153mm,246mm)$);
  \RPGBackRefColumn{28}{222}{LE JET}{Novice : 2d6, garder le plus faible. Compétent : 1d6. Expert : 2d6, garder le plus élevé. Compétence : +1 degré ; pénalité : $-1$ degré.}
  \RPGBackRefColumn{28}{190}{SEUIL DE DIFFICULTÉ}{3 Simple ; 4 Ordinaire ; 5 Difficile ; 6 Extrême ; Critique Miraculeux.}
  \RPGBackRefColumn{28}{158}{CRITIQUE}{Deux 6 ou davantage avec au moins deux dés. Un échec exige un changement de circonstances.}
  \RPGBackRefColumn{28}{126}{EFFORT}{Ajoutez 1d6 avant le jet, subissez 1 Blessure de Fatigue après. Une fois par action.}
  \RPGBackRefColumn{111}{222}{DÉGÂTS}{Arme et Caractéristique déterminent Blessures (B) ou Fatigue (F). Un Critique inflige +1 Blessure.}
  \RPGBackRefColumn{111}{190}{BLESSURES}{À 2 PV ou moins : $-1$ degré. À 1 PV : $-2$ degrés. À zéro : hors de scène.}
  \RPGBackRefColumn{111}{158}{REPOS}{Court : 1 Blessure récupérée. Long : toutes les Blessures et réinitialisation de l'Épuisement.}
  \filldraw[fill=white,draw=coverink,line width=.55pt] ($(current page.south west)+(139mm,25mm)$) rectangle ($(current page.south west)+(187mm,55mm)$);
 \end{tikzpicture}
 \clearpage\RPGCoverPagefalse
}
