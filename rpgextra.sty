\newcommand{\RPGBackCoverGerman}[1]{%
\RPGBackStart{#1}
\RPGBackRefColumn{28}{222}{WÜRFELPROBE}{Ungeübt: 2W6, niedrigster. Kompetent: 1W6. Experte: 2W6, höchster. Fertigkeit: +1 Stufe; Malus: $-1$ Stufe.}
\RPGBackRefColumn{28}{190}{ZIELWERT}{3 Einfach; 4 Normal; 5 Schwer; 6 Extrem; Kritisch: wundersam (zwei Sechsen).}
\RPGBackRefColumn{28}{158}{KRITISCH}{Mindestens zwei Sechsen mit zwei Würfeln. Ein Fehlschlag erfordert neue Umstände.}
\RPGBackRefColumn{28}{126}{VERAUSGABUNG}{Vor dem Wurf +1W6; danach 1 Ermüdungswunde. Einmal pro Handlung.}
\RPGBackRefColumn{111}{222}{SCHADEN}{Waffe und Attribut bestimmen Wunden (Wu) oder Ermüdung (E). Kritisch im Kampf: +1 Wunde.}
\RPGBackRefColumn{111}{190}{WUNDEN}{Bei 2 LP oder weniger: $-1$ Stufe; bei 1 LP: $-2$. Bei null: aus der Szene.}
\RPGBackRefColumn{111}{158}{RAST}{Kurz: 1 Wunde heilen. Lang: alle Wunden heilen und Erschöpfung zurücksetzen.}
\RPGBackFinish
}
\newcommand{\RPGBackCoverSpanish}[1]{%
\RPGBackStart{#1}
\RPGBackRefColumn{28}{222}{LA TIRADA}{Inexperto: 2d6, menor. Competente: 1d6. Experto: 2d6, mayor. Habilidad: +1 grado; penalización: $-1$.}
\RPGBackRefColumn{28}{190}{NÚMERO OBJETIVO}{3 Sencilla; 4 Normal; 5 Difícil; 6 Extrema; Crítico: milagroso.}
\RPGBackRefColumn{28}{158}{CRÍTICO}{Dos o más seises con al menos dos dados. Tras fallar hacen falta nuevas circunstancias.}
\RPGBackRefColumn{28}{126}{ESFUERZO}{Añade 1d6 antes de tirar y sufre 1 Herida de Fatiga después. Una vez por acción.}
\RPGBackRefColumn{111}{222}{DAÑO}{Arma y Atributo determinan Heridas (H) o Fatiga (F). Un Crítico en combate añade 1 Herida.}
\RPGBackRefColumn{111}{190}{HERIDAS}{Con 2 PV o menos: $-1$ grado. Con 1 PV: $-2$. Con cero: fuera de escena.}
\RPGBackRefColumn{111}{158}{DESCANSO}{Corto: recupera 1 Herida. Largo: todas las Heridas y reinicio del Agotamiento.}
\RPGBackFinish
}
