\newcommand{\RPGBookTitle}{Manuale di gioco}
\newcommand{\RPGSetRunningTitle}[1]{\renewcommand{\RPGBookTitle}{#1}}
\newcounter{rpgchapter}
\renewcommand{\therpgchapter}{\Roman{rpgchapter}}
\newcommand{\RPGChapter}[1]{%
  \par\needspace{10\baselineskip}\addvspace{21pt}%
  \refstepcounter{rpgchapter}%
  \phantomsection\addcontentsline{toc}{section}{\protect\numberline{\therpgchapter.}#1}%
  \begin{center}\vspace{0pt}{\fontsize{19}{23}\selectfont\bfseries \therpgchapter\,\textperiodcentered\,\MakeUppercase{#1}\par}%
  \vspace{7pt}{\color{rpgline}\rule{.72\linewidth}{.5pt}}\end{center}\vspace{7pt}%
}
\titleformat{\section}{\normalfont\Large\bfseries\color{rpgbrown}}{}{0pt}{}
\titlespacing*{\section}{0pt}{13pt plus 2pt}{5pt}
\titleformat{\subsection}{\normalfont\large\bfseries\color{rpgbrown}}{}{0pt}{}
\titlespacing*{\subsection}{0pt}{12pt}{4pt}
\newcommand{\rpgcorner}[2]{%
  \begin{scope}[shift={(#1,#2)}]
  \draw[rpgline,line width=.38pt] (0,0)--(.22,0)--(.22,.22)--(0,.22);
  \draw[rpgline,line width=.38pt] (0,.09)--(.44,.09) ( .09,0)--(.09,.44);
  \draw[rpgline,line width=.38pt] (0,0)--(.31,.31);
  \end{scope}}
\newcommand{\RPGFrame}{%
\begin{tikzpicture}[remember picture,overlay]
\coordinate (SW) at ([xshift=15mm,yshift=15mm]current page.south west);
\coordinate (NE) at ([xshift=-15mm,yshift=-15mm]current page.north east);
\draw[rpgline,line width=.9pt] (SW) rectangle (NE);
\draw[rpgline,line width=.35pt] ([xshift=2mm,yshift=2mm]SW) rectangle ([xshift=-2mm,yshift=-2mm]NE);
\coordinate (NW) at (SW |- NE);
\coordinate (SE) at (NE |- SW);
\begin{scope}[shift={(SW)}]\rpgcorner{.18}{.18}\end{scope}
\begin{scope}[shift={(SE)},xscale=-1]\rpgcorner{.18}{.18}\end{scope}
\begin{scope}[shift={(NW)},yscale=-1]\rpgcorner{.18}{.18}\end{scope}
\begin{scope}[shift={(NE)},rotate=180]\rpgcorner{.18}{.18}\end{scope}
\end{tikzpicture}}
\newif\ifRPGCoverPage
\RPGCoverPagefalse
\AddToHook{shipout/background}{\ifRPGCoverPage\else\RPGFrame\fi}
