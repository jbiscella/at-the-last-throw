 \renewcommand{\headrulewidth}{0pt}\renewcommand{\footrulewidth}{0pt}}
\fancypagestyle{rpgfrontmatter}{%
 \fancyhf{}%
 \fancyhead[C]{{\footnotesize\itshape\color{rpgline}\RPGBookTitle}}%
 \renewcommand{\headrulewidth}{0pt}\renewcommand{\footrulewidth}{0pt}}
\newcommand{\RPGStartFrontMatter}{\pagenumbering{gobble}}
\newcommand{\RPGStartContents}{\pagenumbering{roman}}
\newcommand{\RPGStartMainMatter}{\pagenumbering{arabic}\setcounter{page}{1}}
\pagestyle{rpg}
\newcolumntype{Y}{>{\raggedright\arraybackslash}X}
% Use the simpler, robust table API below for arbitrary column counts.
\NewDocumentEnvironment{rpgtable}{m}{%
\par\smallskip\begingroup\setlength{\arrayrulewidth}{.34pt}\arrayrulecolor{rpgline}\renewcommand{\arraystretch}{1.32}%
\rowcolors{2}{rpgshade}{white}%
\tabularx{\linewidth}{|#1|}\hline
}{\endtabularx\arrayrulecolor{black}\endgroup\par\smallskip}
\newcommand{\rpghead}[1]{\cellcolor{rpgbrown}{\color{white}\bfseries #1}}
\newtcolorbox{rpgnote}[1][]{enhanced,breakable,colback=rpgpaper,colframe=rpgline,boxrule=.55pt,arc=0pt,left=9pt,right=9pt,top=7pt,bottom=7pt,fontupper=\itshape,#1}
\newtcolorbox{rpgexample}[2][]{enhanced,breakable,colback=rpgpaper,colframe=rpgbrown,boxrule=.6pt,arc=0pt,left=11pt,right=11pt,top=9pt,bottom=8pt,fonttitle=\bfseries\itshape,coltitle=rpgbrown,title={#2},attach title to upper={\par\vspace{5pt}},#1}
\NewDocumentCommand{\RPGIllustratedBox}{m m +m}{%
\begin{tcolorbox}[enhanced,colback=rpgpaper,colframe=rpgbrown,boxrule=.7pt,arc=0pt,left=5pt,right=7pt,top=5pt,bottom=5pt]
\begin{minipage}[c]{.30\linewidth}\centering
\IfBlankTF{#2}{%
\begin{tikzpicture}[scale=.9]\draw[rpgline,line width=.8pt] (-1.2,-1.1) rectangle (1.2,1.1);\draw[rpgbrown,line width=.9pt,rotate=20] (-.43,-.43) rectangle (.43,.43);\fill[rpgbrown] (-.22,.05) circle(.07) (.15,.05) circle(.07) (0,-.18) circle(.07);\end{tikzpicture}}{\IfFileExists{#2}{\includegraphics[width=\linewidth]{#2}}{\textit{Immagine non trovata}}}%
\end{minipage}\hfill
\begin{minipage}[c]{.64\linewidth}{\bfseries\itshape #1}\par\smallskip\itshape #3\end{minipage}
\end{tcolorbox}}
\newcommand{\RPGTitlePage}[3]{%
\thispagestyle{rpg}\vspace*{.22\textheight}
\begin{center}{\fontsize{34}{39}\selectfont\bfseries #1\par}\vspace{12pt}
{\color{rpgline}\rule{.72\linewidth}{.7pt}}\vspace{17pt}\par
{\Large\itshape #2\par}\vfill {\small #3\par}\vspace{20mm}\end{center}\clearpage}
% Contents has a deliberate one-page composition: heading, TOC, engraved illustration,
% then authorship and licensing. Avoids the credits bleeding onto the following chapter.
\newcommand{\RPGContents}{%
\thispagestyle{rpgfrontmatter}\vspace*{9mm}
\begin{center}{\fontsize{27}{31}\selectfont\bfseries TABLE OF CONTENTS\par}\vspace{9pt}
{\color{rpgline}\rule{.76\linewidth}{.55pt}}\end{center}\vspace{7mm}
\begingroup\makeatletter
\renewcommand{\tableofcontents}{\@starttoc{toc}}% avoid redundant second Contents heading
\renewcommand{\l@section}[2]{\csname @dottedtocline\endcsname{1}{0em}{3.2em}{\bfseries ##1}{##2}}
\makeatother\tableofcontents\endgroup
